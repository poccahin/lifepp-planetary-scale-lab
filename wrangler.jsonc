{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifepp-scale-lab-reproducer",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
